#include <windows.h>

#include "resource.h"

IDI_APPICON ICON "assets\\app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0, 4, 1, 0
PRODUCTVERSION 0, 4, 1, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Explorer Extras"
            VALUE "FileVersion", "0.4.1.0"
            VALUE "InternalName", "ExplorerExtras"
            VALUE "OriginalFilename", "ExplorerExtras.exe"
            VALUE "ProductName", "Explorer Extras"
            VALUE "ProductVersion", "0.4.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
